{
  "name": "pi-zellij",
  "version": "0.4.6",
  "description": "Pi package with zellij-powered terminal integrations",
  "author": "Javi Molina",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "zellij",
    "terminal"
  ],
  "homepage": "https://github.com/javiermolinar/pi-zellij#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javiermolinar/pi-zellij.git"
  },
  "bugs": {
    "url": "https://github.com/javiermolinar/pi-zellij/issues"
  },
  "bin": {
    "pi-zellij": "install.mjs"
  },
  "files": [
    "src/",
    "install.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/node": "^24.12.4",
    "typescript": "^6.0.3"
  }
}
