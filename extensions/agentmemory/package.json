{
  "name": "pi-agentmemory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tasercake/pi-extensions.git",
    "directory": "extensions/agentmemory"
  },
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "tsx --test test/config.test.ts test/errors.test.ts test/client.test.ts test/daemon.test.ts test/launcher.test.ts test/capture.test.ts test/extension.test.ts test/package.test.ts",
    "test:integration": "tsx --test test/daemon-concurrency.test.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "coverage": "tsx --test --experimental-test-coverage test/*.test.ts"
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@types/node": "^26.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "files": ["src", "README.md", "LICENSE", "NOTICE"]
}
